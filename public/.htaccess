# ===== Kristalia — configuración Apache / LiteSpeed (Hostinger) =====
# Sirve el sitio prerenderizado: cada ruta válida tiene su propio index.html en
# una carpeta (p. ej. /quienes-somos/index.html). Las rutas inexistentes deben
# terminar en un 404 REAL, no en un fallback universal a index.html (eso era la
# causa del soft 404). Este fichero vive en public/ y Vite lo copia a dist/.

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1) Host canónico: forzar HTTPS y quitar www -> https://kristalia.es
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 2) Quitar la barra final (excepto en la raíz) para una única forma de URL
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 3) Si el fichero solicitado existe (assets, robots.txt, sitemap.xml, imágenes,
  #    webmanifest...), servirlo tal cual.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4) Si existe un index.html prerenderizado para esta ruta, servirlo de forma
  #    INTERNA (sin redirección, HTTP 200). Ej.: /quienes-somos -> /quienes-somos/index.html
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]

  # 5) Cualquier otra cosa NO existe: no hay fallback a index.html.
  #    Apache no encuentra el recurso y devuelve 404 (ver ErrorDocument abajo).
</IfModule>

# 404 real: contenido de la página 404 prerenderizada, servido con estado HTTP 404.
ErrorDocument 404 /404.html

# Compresión (por si el servidor no la aplica ya).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Caché larga para los assets con hash (nombre único por contenido).
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpg|jpeg|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # El HTML no se cachea de forma agresiva: debe reflejar los despliegues.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
